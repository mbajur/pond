<% if @post.errors.any? %>
  <turbo-stream action="toast" target="ruby-ui-toaster" variant="error" title="Error" description="<%= @post.errors.full_messages&.to_sentence %>">
    <template></template>
  </turbo-stream>
<% else %>
  <turbo-stream action="toast" target="ruby-ui-toaster" variant="success" title="All good!" description="Post was successfully created.">
    <template></template>
  </turbo-stream>

   <turbo-stream action="close_dialog" target="remote-dialog">
    <template></template>
  </turbo-stream>

  <turbo-stream action="replace" target="<%= dom_id(@collection, :row) %>">
    <template>
      <%= render Components::Collections::Collection.new(collection: @collection) %>
    </template>
  </turbo-stream>
<% end %>
